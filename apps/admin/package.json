{
  "name": "@arena/admin",
  "version": "0.0.1",
  "private": true,
  "description": "Private SABG operator console and control API boundary.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx src/server/run.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
