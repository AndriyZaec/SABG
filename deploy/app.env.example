# URL-encode reserved characters in the password used in this URL.
DATABASE_URL=postgres://arena_app:REPLACE_APP_DATABASE_PASSWORD@postgres:5432/arena

NODE_ENV=production
CS2_RUNTIME_MODE=catalog
SOLANA_NETWORK=devnet

AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_REQUIRE_SIGNATURE=true
# Generate from the event code with `hashEventAccessCode` in apps/api/src/gateway/event-access.ts.
EVENT_ACCESS_CODE_HASH=scrypt$REPLACE_SALT$REPLACE_HASH
CORS_ORIGINS=*

# Optional CS2 raw recording. URL-encode reserved characters in the password.
# The Mongo user is created by deploy/mongo-init.sh when the live profile starts.
MONGODB_URI=mongodb://arena_ingest:REPLACE_MONGO_APP_PASSWORD@mongo:27017/sabg_raw?authSource=sabg_raw
MONGODB_DB=sabg_raw
CS2_RAW_RECORDING_ENABLED=false

# GRID Central Data discovery and the selected Series State feed.
GRID_API_KEY=REPLACE_WITH_GRID_API_KEY
# GRID_CENTRAL_DATA_API_KEY=REPLACE_WITH_FULL_ACCESS_GRID_API_KEY
GRID_GRAPHQL_URL=https://api-op.grid.gg/live-data-feed/series-state/graphql
GRID_CENTRAL_DATA_URL=https://api-op.grid.gg/central-data/graphql
# Comma-separated GRID tournament IDs. Empty exposes no CS2 catalog Series.
CS2_CATALOG_TOURNAMENT_IDS=
GRID_SERIES_ID=28
# Required when CS2_RUNTIME_MODE=live.
# CS2_SCHEDULED_START_TIME=2026-09-01T12:00:00.000Z
CS2_GATEWAY_PORT=4000
GRID_POLL_INTERVAL_MS=10000
GRID_RATE_LIMIT_RETRY_MS=1000
GRID_MAX_RATE_LIMIT_RETRIES=5
GRID_REQUEST_TIMEOUT_MS=15000
GRID_QUERY_FILE=dist/graphql-schema-request.txt
CS2_DISCOVERY_LOOKBACK_HOURS=24
CS2_DISCOVERY_LOOKAHEAD_DAYS=30

ONCHAIN_ARENAS_ENABLED=true
ARENA_RPC_URL=https://api.devnet.solana.com
ARENA_AUTHORITY_SECRET=REPLACE_WITH_DEDICATED_DEVNET_AUTHORITY
ARENA_AUTHORITY_RESERVE_LAMPORTS=50000000

LOG_LEVEL=info
