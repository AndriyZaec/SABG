{$SABG_LANDING_HOST:landing.localhost} {
	encode zstd gzip

	@appOnly path /api /api/* /cs2-api /cs2-api/* /ws /cs2-ws /manifest.webmanifest /sw.js
	respond @appOnly 404

	handle {
		reverse_proxy app:4000
	}
}

www.{$SABG_LANDING_HOST:landing.localhost} {
	redir https://{$SABG_LANDING_HOST:landing.localhost}{uri} permanent
}

{$SABG_HOST:localhost} {
	encode zstd gzip

	handle_path /cs2-api/* {
		rewrite * /api{uri}
		reverse_proxy app:4000
	}

	@cs2Ws path /cs2-ws
	handle @cs2Ws {
		rewrite * /ws
		reverse_proxy app:4000
	}

	handle {
		reverse_proxy app:4000
	}
}
