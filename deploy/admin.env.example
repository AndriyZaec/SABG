NODE_ENV=production
ADMIN_PORT=4174
ADMIN_PUBLIC_ORIGIN=https://admin.sabg.fun

ADMIN_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_ID
ADMIN_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_SECRET
# Comma-separated immutable GitHub numeric user IDs.
ADMIN_GITHUB_ALLOWED_USER_IDS=REPLACE_WITH_ALLOWED_GITHUB_USER_IDS
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Keep this URL on the internal Docker control network. The token must exactly match deploy/app.env.
CS2_CONTROL_URL=http://app-control:4101
CS2_CONTROL_MACHINE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
