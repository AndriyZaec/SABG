    "react-router-dom": "^6.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.22.5",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
